              "type": "text/plain"
            },
            "url": {
              "path": [
                "areaapi",
                "v2.0.0",
                "geography",
                "lookup"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "name",
                  "value": "<string>",
                  "description": "Area name to search for."
                },
                {
                  "disabled": false,
                  "key": "geographyTypeAbbreviation",
                  "value": "<string>",
                  "description": "Geography type code (e.g. CO, PL, N2, DB, ZI)."
